# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/portfolio

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# Gemini API (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — kept for future chatbot LLM use (NOT used for embeddings)
# Embeddings are now generated locally — no API key needed for indexing.
OPENAI_API_KEY=sk-...

# Local embedding model (free, no API key, no Docker)
# Model downloaded once on first run (~25 MB) and cached locally.
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional: override HuggingFace model cache location
# HF_CACHE_DIR=D:\My_portfolio\backend\.hf_cache

# Embedding batch size — texts per pipeline call (default 20)
EMBEDDING_BATCH_SIZE=20

# Vector store — vectra LocalIndex (no Docker, no external server)
# Data is stored as JSON files at this path.
# Defaults to backend/vector_store/ if omitted.
VECTOR_STORE_PATH=D:\My_portfolio\backend\vector_store

# Contact form email — Gmail SMTP
# SMTP_PASS must be a Google App Password, NOT your account password.
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_TO=your_gmail_address@gmail.com
# Optional: display name on the From header
# SMTP_FROM="Portfolio" <your_gmail_address@gmail.com>

# Set to 1 when running behind a reverse proxy so rate limiting
# sees real client IPs instead of the proxy's.
# TRUST_PROXY=1
